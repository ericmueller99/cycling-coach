# Copy to .env and fill in. Used by both `docker compose up` (self-host) and `pnpm dev`.

# ── Database ────────────────────────────────────────────────────────────────
# `pnpm dev`: the Mongo started by `pnpm db:up`. The Docker app ignores this and always uses the
# bundled Mongo container.
MONGO_DB_URI=mongodb://localhost:27017/?directConnection=true
MONGO_DB_NAME=cycling_coach

# ── Auth (Better Auth) ──────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# `pnpm dev` addresses. The Docker app sets both from PUBLIC_URL instead.
BETTER_AUTH_URL=http://localhost:8787
APP_URL=http://localhost:5173
# Dev only: a public tunnel address (e.g. ngrok) for testing the Vite dev server on a phone.
# DEV_PUBLIC_URL=https://your-tunnel.example.com
PORT=8787

# ── Docker only ─────────────────────────────────────────────────────────────
# The address you open the app at. Change it when the app sits behind your own https proxy.
# PUBLIC_URL=http://localhost:8787
# Host port the app container publishes.
# APP_PORT=8787

# Your login, created once by the seed (sign-up is disabled after that).
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=

# ── Claude ──────────────────────────────────────────────────────────────────
# An Anthropic API key from console.anthropic.com. Named CLAUDE_API_KEY (not ANTHROPIC_API_KEY)
# so nothing else on the machine picks it up implicitly.
CLAUDE_API_KEY=

# ── Training data: intervals.icu (docs/DECISIONS.md #13) ────────────────────
# intervals.icu → Settings → Developer Settings → API key. One key = one athlete (single-user app).
INTERVALS_ICU_KEY=
# "0" means the athlete who owns the key.
INTERVALS_ICU_ATHLETE_ID=0

# ── Zwift metrics: zFTP, zMAP, weight, FTP (docs/DECISIONS.md #23) ──────────
# Optional, at your own risk: your Zwift login, for zFTP/zMAP/weight (every 6 hours) and "Get more
# events". It uses Zwift's unofficial API; not endorsed by Zwift and may breach its terms (README,
# "Zwift login"). Read-only. Leave blank to enter zFTP by hand on the Athlete page.
ZWIFT_USERNAME=
ZWIFT_PASSWORD=

# The account the intervals.icu key and Zwift login above belong to (docs/DECISIONS.md #53).
# Blank = the oldest account (the one the seed created). Other accounts never use them.
OWNER_EMAIL=

# ── Food (DECISIONS #33) ───────────────────────────────────────────────────
# Optional staples fallback when the Canadian Nutrient File has nothing: a free api.data.gov key
# (https://fdc.nal.usda.gov/api-key-signup). Blank = the shared DEMO_KEY (30 requests an hour).
USDA_FDC_API_KEY=
# Optional S3-compatible bucket for label photos, stored under cycling-coach/food-images/.
# All four or none — without them photos are read but not kept.
S3_HOSTNAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKETNAME=
S3_REGION=us-east-1
# The staples table: `pnpm food:import-cnf` (the seed runs it when the table is empty).

# ── Background jobs (docs/DECISIONS.md #56) ─────────────────────────────────
# The intervals.icu / Zwift sync schedule, stored in the database. On by default. Several processes
# on one database are safe (each job runs in one of them); set false for a process that should only
# serve requests, e.g. `pnpm dev` beside the Docker app. Manual "Sync now" works either way.
# BACKGROUND_JOBS=false
# JOBS_CONCURRENCY=2
